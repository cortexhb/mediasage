# Copy to .env. Only the three LLM keys are required.
# Every setting is MEDIASAGE_<SECTION>__<FIELD>; sections nest on __.
# Fields and defaults: backend/config/models.py

# anthropic/openai/gemini take an API key; ollama/custom take a URL.
MEDIASAGE_LLM__PROVIDER=custom
MEDIASAGE_LLM__ENDPOINT_URL=http://localhost:11434/v1
# Required: a guessed window overflows the model.
MEDIASAGE_LLM__CONTEXT_WINDOW=32768
#MEDIASAGE_LLM__API_KEY=

# Plex identity is not settable here; the browser sign-in writes it.
#MEDIASAGE_PLEX__MUSIC_LIBRARY=Music

#MEDIASAGE_DEFAULTS__TRACK_COUNT=25
# DEBUG adds one line per static and album-art request.
#MEDIASAGE_LOG_LEVEL=INFO

# Tracing. Also reachable as MEDIASAGE_LANGFUSE__*, or from .env.langfuse.
#LANGFUSE_BASE_URL=
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_TRACING_ENVIRONMENT=
