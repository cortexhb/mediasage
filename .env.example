# MediaSage Environment Variables
# Copy this file to .env and update with your actual values.
#
# Every setting is reachable as MEDIASAGE_<SECTION>__<FIELD>.
# Environment variables override config.yaml and the UI-saved settings.

# Plex Server Configuration
MEDIASAGE_PLEX__URL=http://your-plex-server:32400
MEDIASAGE_PLEX__TOKEN=your-plex-token
#MEDIASAGE_PLEX__MUSIC_LIBRARY=Music

# LLM Provider: anthropic, openai, gemini, ollama, or custom.
# Required -- there is no default. An unconfigured provider fails at startup.
MEDIASAGE_LLM__PROVIDER=custom

# One key, whichever provider is selected. Local providers can leave it unset.
#MEDIASAGE_LLM__API_KEY=

# Required for the local providers (ollama, custom), rejected for the rest.
MEDIASAGE_LLM__ENDPOINT_URL=http://localhost:11434

# Required for every provider. There is no per-model table to fall back on,
# and a guessed window overflows the model instead of failing.
MEDIASAGE_LLM__CONTEXT_WINDOW=32768

# Model names are never guessed; set them or the UI shows them blank.
#MEDIASAGE_LLM__MODEL_ANALYSIS=
#MEDIASAGE_LLM__MODEL_GENERATION=

# Call limits. The defaults suit slow local hardware; lower them for hosted APIs.
#MEDIASAGE_LLM__REQUEST_TIMEOUT=600
#MEDIASAGE_LLM__MAX_OUTPUT_TOKENS=8192
#MEDIASAGE_LLM__MAX_RETRIES=3
#MEDIASAGE_LLM__PROBE_TIMEOUT=5

# Cost display, per million tokens. Unset means unpriced: the UI reports no
# cost rather than one from a price table that has gone stale. Local is free.
#MEDIASAGE_LLM__COST_ANALYSIS_INPUT=3.00
#MEDIASAGE_LLM__COST_ANALYSIS_OUTPUT=15.00
#MEDIASAGE_LLM__COST_GENERATION_INPUT=1.00
#MEDIASAGE_LLM__COST_GENERATION_OUTPUT=5.00

# Prompt budgeting. Measured averages for one library line; raise them if your
# titles run long, since they decide how much of the library fits in a prompt.
#MEDIASAGE_BUDGET__TOKENS_PER_TRACK=40
#MEDIASAGE_BUDGET__TOKENS_PER_ALBUM=25
#MEDIASAGE_BUDGET__CONTEXT_BUFFER_FRACTION=0.10
#MEDIASAGE_BUDGET__RESERVED_PROMPT_TOKENS=1000

# Library cache. Sync behaviour and what counts as a live recording.
# LIVE_KEYWORDS is a JSON array; set it to [] to keep every live version.
#MEDIASAGE_LIBRARY__SYNC_BATCH_SIZE=500
#MEDIASAGE_LIBRARY__STALE_AFTER_HOURS=24
#MEDIASAGE_LIBRARY__WELL_LOVED_AVG_PLAYS=3.0
#MEDIASAGE_LIBRARY__LIVE_KEYWORDS=["live","concert","sbd","bootleg"]
#MEDIASAGE_LIBRARY__DATED_TITLES_ARE_LIVE=true

# UI defaults
#MEDIASAGE_DEFAULTS__TRACK_COUNT=25
